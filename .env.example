# .env.example — Twilio SMS Alert Configuration
# ------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored.
# This file (.env.example) is safe to commit: it contains no real credentials.
#
# Sign up for a free Twilio trial at https://twilio.com to obtain these values.

# Your Twilio Account SID (starts with "AC...")
TWILIO_SID=your_account_sid_here

# Your Twilio Auth Token
TWILIO_TOKEN=your_auth_token_here

# Your Twilio-issued phone number (E.164 format, e.g. +1415xxxxxxx)
TWILIO_FROM=+1xxxxxxxxxx

# The verified recipient phone number that will receive SMS alerts (E.164 format)
# On a Twilio trial account, this number must be verified in the Twilio console.
ALERT_TO=+91xxxxxxxxxx
