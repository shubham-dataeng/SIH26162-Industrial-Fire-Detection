# .env.example — Multi-Channel Alert Configuration (Telegram + Fast2SMS)
# ------------------------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored.
# This file (.env.example) is safe to commit: it contains no real credentials.
#
# Both channels are optional and independent — configure one or both.

# --- Telegram (free) ---
# Create a bot via @BotFather, add it to a group/chat, send a message,
# then visit https://api.telegram.org/bot<TOKEN>/getUpdates to find chat ID.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890

# --- Fast2SMS (requires ₹100+ wallet top-up for API access) ---
# Sign up at https://www.fast2sms.com, find your key under Dev API.
FAST2SMS_API_KEY=your_api_key_here
ALERT_PHONE_NUMBER=9876543210
